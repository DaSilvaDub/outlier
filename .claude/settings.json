{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              ".claude/hooks/block-reasoning.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Checking reasoning house rule..."
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              ".claude/hooks/block-reasoning.py"
            ],
            "timeout": 15,
            "statusMessage": "Checking reasoning house rule (Linux)..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              ".claude/hooks/check-sync.ps1"
            ],
            "timeout": 60,
            "statusMessage": "Verifying outlier sync state..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(./calibration/**)",
      "Write(./calibration/**)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
